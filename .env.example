# 复制本文件为 .env，再把下面换成你的真实 key
# .env 已被 .gitignore 和 .dockerignore 忽略，不会进 git 也不会进镜像
DEEPSEEK_API_KEY=sk-在这里填你的key

# 以下都可选，有默认值，按需取消注释
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# RAG_CHUNK_SIZE=400
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=4
